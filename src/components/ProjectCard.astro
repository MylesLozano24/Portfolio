---
export interface Props {
  title: string;
  tagline: string;
  description: string;
  role: string;
  date: string;
  tech: string[];
  images?: Array<
    | string
    | {
        src: string;
        title: string;
        description: string;
        type?: "image" | "video";
      }
  >;
  links: {
    live?: string;
    github?: string;
  };
  featured?: boolean;
}

const { title, tagline, description, role, date, tech, images, links } = Astro.props;
---

<article class="group border border-white rounded p-8 hover:bg-gray-950 transition-colors">
  <div class="mb-4">
    <div class="flex items-start justify-between mb-2">
      <h3 class="text-xl font-semibold text-white">
        {title}
      </h3>
      <span class="text-xs text-gray-500 ml-4 mt-1 whitespace-nowrap">
        {date}
      </span>
    </div>
    <p class="text-sm text-gray-400 mb-3 font-sans">
      {tagline}
    </p>

    <ul class="space-y-1.5 text-gray-300 text-sm font-sans mb-4">
      {description.split('\n').map((point) => (
        <li class="flex items-start">
          <span class="text-orange-500 mr-2 mt-0.5">→</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mb-4">
    <p class="text-xs text-gray-500 mb-2">
      // {role}
    </p>
    <div class="flex flex-wrap gap-2 text-xs">
      {tech.map((item) => (
        <span class="text-gray-300">
          {item}
        </span>
      ))}
    </div>
  </div>

  {(links.live || links.github) && (
    <div class="flex gap-4 pt-4 border-t border-gray-700 text-xs mb-4">
      {links.live && (
        <a
          href={links.live}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white hover:text-orange-500 transition-colors inline-flex items-center"
        >
          → Read about it here
        </a>
      )}
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white hover:text-orange-500 transition-colors inline-flex items-center"
        >
          → Code
        </a>
      )}
    </div>
  )}

  {images && images.length > 0 && (
    <div class="pt-4 border-t border-gray-700">
      <div class="flex gap-2 overflow-x-auto">
        {images.map((image, index) => {
          const imageSrc = typeof image === 'string' ? image : image.src;
          const imageTitle = typeof image === 'string' ? title : image.title;
          const imageDescription =
            typeof image === 'string'
              ? description.split('\n').join(' • ')
              : image.description;
          const isVideo = typeof image !== 'string' && image.type === 'video';

          return isVideo ? (
            <video
              src={imageSrc}
              controls
              preload="metadata"
              class="h-32 w-auto rounded border border-gray-700 object-cover"
              title={imageTitle}
            />
          ) : (
            <img
              src={imageSrc}
              alt={`${title} screenshot`}
              class="h-32 w-auto rounded border border-gray-700 object-cover cursor-pointer hover:border-orange-500 transition-colors"
              loading="lazy"
              onerror="this.style.display='none'"
              data-project-title={imageTitle}
              data-project-description={imageDescription}
              data-image-index={index}
              onclick="openImageModal(this)"
            />
          );
        })}
      </div>
    </div>
  )}
</article>

<script is:inline>
  function openImageModal(img) {
    const modal = document.getElementById('image-modal');
    const modalImg = document.getElementById('modal-image');
    const modalTitle = document.getElementById('modal-title');
    const modalDescription = document.getElementById('modal-description');

    if (modal && modalImg && modalTitle && modalDescription) {
      modal.classList.remove('hidden');
      modalImg.src = img.src;
      modalTitle.textContent = img.dataset.projectTitle;
      modalDescription.textContent = img.dataset.projectDescription;
      document.body.style.overflow = 'hidden';
    }
  }

  function closeImageModal() {
    const modal = document.getElementById('image-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeImageModal();
    }
  });
</script>
