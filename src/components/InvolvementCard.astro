---
export interface Props {
  name: string;
  role: string;
  date: string;
  description: string;
}

const { name, role, date, description } = Astro.props;
---

<article class="group border border-white rounded p-8 hover:bg-gray-950 transition-colors">
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h3 class="text-xl font-semibold text-white mb-1">
        {name}
      </h3>
      <p class="text-sm text-gray-400">
        {role}
      </p>
    </div>
    <span class="text-xs text-gray-500 ml-4 whitespace-nowrap">
      {date}
    </span>
  </div>

  <p class="text-gray-300 text-sm font-sans leading-relaxed">
    {description}
  </p>
</article>
