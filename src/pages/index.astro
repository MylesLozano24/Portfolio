---
import SEO from '../components/SEO.astro';
import Sidebar from '../components/Sidebar.astro';
import SinglePageFooter from '../components/SinglePageFooter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import InvolvementCard from '../components/InvolvementCard.astro';
import profileData from '../data/profile.json';
import projectsData from '../data/projects.json';
import experienceData from '../data/experience.json';
import involvementData from '../data/involvement.json';
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={`${profileData.name} - ${profileData.headline}`}
      description={profileData.shortBio}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen flex flex-col bg-black text-white transition-colors font-mono">
    <!-- Grid Background with Flashlight Effect -->
    <div id="grid-bg" class="fixed inset-0 pointer-events-none z-0"></div>

    <!-- Page Content Wrapper for Self-Destruct Animation -->
    <div id="page-wrapper" class="min-h-screen flex flex-col">
      <a
        href="#home"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-orange-500 focus:text-black"
      >
        Skip to content
      </a>

      <Sidebar />

      <!-- ===== LOCK EASTER EGG TRIGGER ===== -->
      <!-- Hidden lock icon in top-right, only visible on hover -->
      <button
        id="lock-trigger"
        class="lock-trigger"
        aria-label="Unlock secret"
        title="Unlock"
      >
        <svg class="lock-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </button>

      <!-- ===== HOTDOG EASTER EGG TRIGGER ===== -->
      <!-- Hidden hotdog icon in bottom-left, only visible on hover -->
      <button
        id="hotdog-trigger"
        class="hotdog-trigger"
        aria-label="Hotdog Champion"
        title="?"
      >
        <svg class="hotdog-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
          <!-- Bun (top) -->
          <ellipse cx="32" cy="24" rx="24" ry="8" fill="#D2691E"/>
          <!-- Sausage -->
          <rect x="10" y="26" width="44" height="12" rx="6" fill="#8B4513"/>
          <!-- Bun (bottom) -->
          <ellipse cx="32" cy="40" rx="24" ry="8" fill="#D2691E"/>
          <!-- Mustard zigzag -->
          <path d="M 15 32 L 18 30 L 21 32 L 24 30 L 27 32 L 30 30 L 33 32 L 36 30 L 39 32 L 42 30 L 45 32 L 48 30 L 51 32" stroke="#FFD700" stroke-width="2" fill="none"/>
        </svg>
      </button>

    <main id="main-content" class="flex-1 relative z-10">
      <!-- HOME SECTION -->
      <section id="home" class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 py-20">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white mb-6 animate-slide-up">
            {profileData.name}
          </h1>
          <p class="text-xl sm:text-2xl text-gray-400 mb-4 animate-slide-up" style="animation-delay: 0.1s;">
            {profileData.headline}
          </p>
          <p class="text-lg text-gray-500 mb-8 animate-slide-up" style="animation-delay: 0.15s;">
            {profileData.school}
          </p>
          <p class="text-base text-gray-300 mb-12 max-w-2xl mx-auto animate-slide-up leading-relaxed" style="animation-delay: 0.2s;">
            {profileData.shortBio}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up" style="animation-delay: 0.3s;">
            <a
              href="#contact"
              class="px-8 py-3 bg-orange-500 text-black border border-orange-500 font-medium hover:bg-orange-600 hover:border-orange-600 transition-colors"
            >
              → Contact
            </a>
          </div>
        </div>
      </section>

      <!-- ABOUT SECTION -->
      <section id="about" class="py-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto border border-white rounded-lg p-12 sm:p-16">
          <div class="flex items-start justify-between mb-12 gap-4">
            <h2 class="text-4xl sm:text-5xl font-bold text-white">
              <span class="text-orange-500">[</span>About<span class="text-orange-500">]</span>
            </h2>
            <a
              id="resume-download-btn"
              href="/resume.pdf"
              download
              class="inline-flex items-center px-6 py-2 bg-orange-500 text-black border border-orange-500 font-medium hover:bg-orange-600 hover:border-orange-600 transition-colors text-sm whitespace-nowrap"
            >
              <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span id="resume-btn-text">Download Resume</span>
            </a>
          </div>

          <div class="space-y-6 text-gray-300 leading-relaxed text-lg font-sans">
            {profileData.longBio.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="border-l-2 border-orange-500 pl-6">
              <p class="text-sm text-gray-400 mb-2">
                // Education
              </p>
              <p class="text-lg font-semibold text-white mb-1">
                {profileData.major}
              </p>
              <p class="text-gray-400 mb-1">
                Minor in {profileData.minor}
              </p>
              <p class="text-gray-400">
                <span id="osu-easter-egg-trigger" class="cursor-default">
                  {profileData.school}
                </span>
              </p>
              <p class="text-sm text-gray-500 mt-1">
                {profileData.classStanding}
              </p>
            </div>

            <div class="border-l-2 border-orange-500 pl-6">
              <p class="text-sm text-gray-400 mb-2">
                // GPA
              </p>
              <p class="text-lg font-semibold text-white">
                3.70
              </p>
            </div>

            <div class="border-l-2 border-orange-500 pl-6">
              <p class="text-sm text-gray-400 mb-2">
                // Location
              </p>
              <p class="text-lg text-white">
                {profileData.location}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PROJECTS SECTION -->
      <section id="projects" class="py-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto border border-white rounded-lg p-12 sm:p-16">
          <div class="mb-16">
            <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4">
              <span class="text-orange-500">[</span>Projects<span class="text-orange-500">]</span>
            </h2>
            <p class="text-xl text-gray-400 max-w-2xl">
              Engineering projects and product development work
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {projectsData.map((project) => (
              <ProjectCard
                title={project.title}
                tagline={project.tagline}
                description={project.description}
                role={project.role}
                date={project.date}
                tech={project.tech}
                images={project.images}
                links={project.links}
                featured={project.featured}
              />
            ))}
          </div>
        </div>
      </section>

      <!-- EXPERIENCE SECTION -->
      <section id="experience" class="py-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto border border-white rounded-lg p-12 sm:p-16">
          <h2 class="text-4xl sm:text-5xl font-bold text-white mb-16">
            <span class="text-orange-500">[</span>Experience<span class="text-orange-500">]</span>
          </h2>

          <div class="space-y-12">
            {experienceData.map((exp) => (
              <div class="relative pl-8 border-l border-gray-700">
                <div class="absolute w-2 h-2 bg-orange-500 -left-[5px] top-1"></div>

                <div class="mb-2">
                  <h3 class="text-2xl font-semibold text-white">
                    {exp.title}
                  </h3>
                  <p class="text-lg text-gray-400 mt-1">
                    {exp.company}
                  </p>
                  <p class="text-sm text-gray-500 mt-1">
                    {exp.location} • {exp.period}
                  </p>
                </div>

                <p class="text-gray-300 mb-4 leading-relaxed font-sans">
                  {exp.description}
                </p>

                {exp.achievements.length > 0 && (
                  <ul class="space-y-2 text-gray-300 font-sans">
                    {exp.achievements.map((achievement) => (
                      <li class="flex items-start">
                        <span class="text-orange-500 mr-2">→</span>
                        <span>{achievement}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- INVOLVEMENT SECTION -->
      <section id="involvement" class="py-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto border border-white rounded-lg p-12 sm:p-16">
          <div class="mb-16">
            <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4">
              <span class="text-orange-500">[</span>Involvement<span class="text-orange-500">]</span>
            </h2>
            <p class="text-xl text-gray-400 max-w-2xl">
              Clubs, organizations, and affiliations
            </p>
          </div>

          <div class="space-y-6">
            {involvementData.map((item) => (
              <InvolvementCard
                name={item.name}
                role={item.role}
                date={item.date}
                description={item.description}
              />
            ))}
          </div>
        </div>
      </section>

      <!-- SKILLS SECTION -->
      <section id="skills" class="py-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto border border-white rounded-lg p-12 sm:p-16">
          <h2 class="text-4xl sm:text-5xl font-bold text-white mb-16">
            <span class="text-orange-500">[</span>Skills<span class="text-orange-500">]</span>
          </h2>

          <div class="border border-gray-700 rounded p-8">
            <div class="text-sm text-gray-400 mb-6"><span class="text-orange-500">></span> skills --list</div>
            <div class="flex flex-wrap gap-3">
              {['SolidWorks', 'AutoCAD', 'Python', 'MATLAB', 'LabVIEW', 'Mechanical Design', 'Engineering Analysis', 'FEA', 'CFD', 'DFM & Cost Reduction', 'Prototyping & Testing', 'Manufacturing Processes', 'Process Improvement', 'Root Cause Analysis', 'Quality Improvement', 'CAD Documentation', 'Technical Documentation', 'Embedded Systems', 'Microcontroller Hardware', 'LoRa', 'GPS & BLE Systems', 'Systems Integration', 'Product Development', 'Project Coordination', 'Business Development', 'Customer Discovery', 'Market Research', 'Product Positioning', 'Grant & Investor Materials', 'Commercialization Planning'].map((skill) => (
                <span class="border border-white rounded px-4 py-2 text-sm text-white">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- CONTACT SECTION -->
      <section id="contact" class="py-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto border border-white rounded-lg p-12 sm:p-16">
          <h2 class="text-4xl sm:text-5xl font-bold text-white mb-16">
            <span class="text-orange-500">[</span>Contact<span class="text-orange-500">]</span>
          </h2>

          <div class="border border-gray-700 rounded p-10">
            <div class="space-y-6">
              <div class="flex items-start gap-3">
                <span class="text-gray-400 text-sm">Email:</span>
                <a
                  href="mailto:24lozanom@gmail.com"
                  class="text-white hover:text-orange-500 transition-colors underline"
                >
                  24lozanom@gmail.com
                </a>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-gray-400 text-sm">LinkedIn:</span>
                <a
                  href="https://www.linkedin.com/in/myles-lozano"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white hover:text-orange-500 transition-colors underline break-all"
                >
                  https://www.linkedin.com/in/myles-lozano
                </a>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-gray-400 text-sm">GitHub:</span>
                <a
                  href="https://github.com/MylesLozano24"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white hover:text-orange-500 transition-colors underline break-all"
                >
                  https://github.com/MylesLozano24
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

      <SinglePageFooter />
    </div>
    <!-- End Page Wrapper -->

    <!-- ===== LOCK EASTER EGG OVERLAYS ===== -->

    <!-- Password Modal -->
    <div id="password-modal" class="hidden fixed inset-0 z-[150] flex items-center justify-center p-4">
      <!-- Background overlay -->
      <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" id="password-modal-backdrop"></div>

      <!-- Password panel -->
      <div class="relative bg-black border-2 border-orange-500 rounded p-8 max-w-md w-full">
        <!-- Close button -->
        <button
          id="password-close"
          class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors text-2xl leading-none"
          aria-label="Close"
        >
          ×
        </button>

        <!-- Terminal header -->
        <div class="mb-6">
          <p class="text-orange-500 text-sm mb-2">> auth --unlock</p>
        </div>

        <!-- Password input -->
        <div class="mb-4">
          <input
            type="password"
            id="password-input"
            class="w-full bg-gray-950 border border-gray-700 rounded px-4 py-2 text-white font-mono focus:outline-none focus:border-orange-500 transition-colors"
            placeholder="Enter password..."
            autocomplete="off"
          />
        </div>

        <!-- Error message -->
        <p id="password-error" class="text-red-500 text-sm font-mono hidden">
          error: invalid key
        </p>
      </div>
    </div>

    <!-- Secret Overlay (TODO: Add your secret content here) -->
    <div id="secret-overlay" class="hidden fixed inset-0 z-[160] flex items-center justify-center p-4">
      <!-- Background overlay -->
      <div class="absolute inset-0 bg-black/90 backdrop-blur-md" id="secret-overlay-backdrop"></div>

      <!-- Secret content panel -->
      <div class="relative bg-black border-2 border-orange-500 rounded p-12 max-w-2xl w-full">
        <!-- Close button -->
        <button
          id="secret-close"
          class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors text-2xl leading-none"
          aria-label="Close"
        >
          ×
        </button>

        <!-- ===== EDIT SECRET CONTENT BELOW ===== -->
        <div class="text-center">
          <h2 class="text-4xl font-bold text-orange-500 mb-4">
            Unlocked
          </h2>
          <p class="text-xl text-gray-300 mb-6 font-sans">
            TODO: Add secret content here
          </p>
          <p class="text-sm text-gray-500 font-mono">
            // Edit this section in index.astro<br/>
            // Search for "EDIT SECRET CONTENT BELOW"
          </p>
        </div>
        <!-- ===== EDIT SECRET CONTENT ABOVE ===== -->
      </div>
    </div>

    <!-- Hotdog Champion Overlay -->
    <div id="hotdog-overlay" class="hidden fixed inset-0 z-[160] flex items-center justify-center p-4">
      <!-- Background overlay -->
      <div class="absolute inset-0 bg-black/90 backdrop-blur-md" id="hotdog-overlay-backdrop"></div>

      <!-- Confetti container -->
      <div id="confetti-container" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

      <!-- Hotdog content panel -->
      <div class="relative bg-black border-2 border-orange-500 rounded p-12 max-w-2xl w-full">
        <!-- Close button -->
        <button
          id="hotdog-close"
          class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors text-2xl leading-none"
          aria-label="Close"
        >
          ×
        </button>

        <!-- Hotdog Champion Content -->
        <div class="text-center">
          <h2 class="text-4xl font-bold text-orange-500 mb-6">
            2021 Bratwurst Eating Contest Champion
          </h2>
          <div class="mb-6">
            <img
              src="/hotdog.jpg"
              alt="2021 Erntefest Bratwurst Eating Championship"
              class="mx-auto rounded-lg border-2 border-orange-500 max-w-full h-auto"
              style="max-height: 400px;"
            />
          </div>
          <p class="text-xl text-gray-300 font-sans leading-relaxed">
            Winner of the 2021 Erntefest Bratwurst Eating Championship
          </p>
          <p class="text-sm text-gray-500 mt-4 font-mono">
            // A legacy of competitive excellence
          </p>
        </div>
      </div>
    </div>

    <!-- Image Modal -->
    <div id="image-modal" class="hidden fixed inset-0 z-[100] bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="max-w-4xl w-full relative">
        <button
          onclick="closeImageModal()"
          class="absolute -top-10 right-0 text-white hover:text-orange-500 transition-colors text-3xl leading-none z-10 bg-black/50 w-8 h-8 rounded-full flex items-center justify-center"
          aria-label="Close modal"
        >
          ×
        </button>

        <div class="bg-black border-2 border-white rounded-lg overflow-hidden shadow-2xl">
          <img
            id="modal-image"
            src=""
            alt="Project screenshot"
            class="w-full h-auto max-h-[60vh] object-contain bg-gray-950"
          />
          <div class="p-6 border-t border-gray-700">
            <h3 id="modal-title" class="text-xl font-semibold text-white mb-2"></h3>
            <p id="modal-description" class="text-gray-300 text-sm font-sans leading-relaxed"></p>
          </div>
        </div>
      </div>

      <!-- Click outside to close -->
      <div
        class="absolute inset-0 -z-10"
        onclick="closeImageModal()"
      ></div>
    </div>

    <script is:inline>
      function initializeTheme() {
        const getThemePreference = () => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        const setTheme = (theme) => {
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          localStorage.setItem('theme', theme);
        };

        const toggleTheme = () => {
          const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          setTheme(newTheme);
        };

        setTheme(getThemePreference());

        const themeToggle = document.getElementById('theme-toggle');
        const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

        themeToggle?.addEventListener('click', toggleTheme);
        mobileThemeToggle?.addEventListener('click', toggleTheme);
      }

      initializeTheme();
      document.addEventListener('astro:after-swap', initializeTheme);
    </script>

    <script is:inline>
      function initializeGridBackground() {
        const gridBg = document.getElementById('grid-bg');
        if (!gridBg) return;

        // Track mouse position
        let mouseX = 0;
        let mouseY = 0;

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;

          // Update CSS variables for the flashlight position
          gridBg.style.setProperty('--mouse-x', `${mouseX}px`);
          gridBg.style.setProperty('--mouse-y', `${mouseY}px`);
        });

        // Initialize with center position
        const centerX = window.innerWidth / 2;
        const centerY = window.innerHeight / 2;
        gridBg.style.setProperty('--mouse-x', `${centerX}px`);
        gridBg.style.setProperty('--mouse-y', `${centerY}px`);
      }

      initializeGridBackground();
      document.addEventListener('astro:after-swap', initializeGridBackground);
    </script>

    <script is:inline>
      /**
       * Self-Destruct Easter Egg
       *
       * How it works:
       * 1. Explosion: CSS-only particle effect using box-shadows positioned at button center
       * 2. Page Fall: Entire page wrapper translates down 100vh and fades out
       * 3. Reset: After 5s, content fades back in and returns to original position
       * 4. Lock: Animation state prevents retriggering during playback
       */
      function initializeSelfDestruct() {
        const btn = document.getElementById('self-destruct-btn');
        const pageWrapper = document.getElementById('page-wrapper');

        if (!btn || !pageWrapper) return;

        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let isAnimating = false;

        btn.addEventListener('click', function(e) {
          // Prevent retriggering during animation
          if (isAnimating) return;

          // Respect reduced motion preference
          if (prefersReducedMotion) {
            console.log('Self-destruct disabled: user prefers reduced motion');
            return;
          }

          isAnimating = true;

          // Get button position for countdown overlay
          const rect = btn.getBoundingClientRect();
          const buttonCenterX = rect.left + rect.width / 2;
          const buttonCenterY = rect.top + rect.height / 2;

          // Create countdown overlay
          const countdown = document.createElement('div');
          countdown.className = 'countdown-overlay';
          countdown.style.left = buttonCenterX + 'px';
          countdown.style.top = buttonCenterY + 'px';
          document.body.appendChild(countdown);

          // Countdown sequence: 3, 2, 1
          let count = 3;
          countdown.textContent = count;
          countdown.classList.add('show');

          const countdownInterval = setInterval(() => {
            count--;
            if (count > 0) {
              countdown.textContent = count;
              // Trigger scale animation
              countdown.classList.remove('pulse');
              void countdown.offsetWidth; // Force reflow
              countdown.classList.add('pulse');
            } else {
              clearInterval(countdownInterval);
              countdown.remove();

              // Trigger explosion after countdown
              const explosion = document.createElement('div');
              explosion.className = 'explosion';
              explosion.style.left = buttonCenterX + 'px';
              explosion.style.top = buttonCenterY + 'px';
              document.body.appendChild(explosion);

              // Trigger explosion animation
              requestAnimationFrame(() => {
                explosion.classList.add('explode');
              });

              // Start page fall after short delay (150ms)
              setTimeout(() => {
                pageWrapper.classList.add('self-destruct-fall');
              }, 150);

              // Reset everything after 5 seconds
              setTimeout(() => {
                // Remove explosion element
                explosion.remove();

                // Reset page position
                pageWrapper.classList.remove('self-destruct-fall');

                // Re-enable button after reset completes
                setTimeout(() => {
                  isAnimating = false;
                }, 1000);
              }, 5000);
            }
          }, 1000); // 1 second per count
        });
      }

      initializeSelfDestruct();
      document.addEventListener('astro:after-swap', initializeSelfDestruct);
    </script>

    <script is:inline>
      /**
       * BULLET THE HORSE EASTER EGG
       *
       * Trigger: Click on "Oklahoma State University" text in Education section
       * Behavior:
       * 1. Show notification "Here comes Bullet!" at top center (2s)
       * 2. Animate Bullet.png galloping from right to left across screen (6s)
       * 3. Horse appears behind content, sized relative to main heading
       * 4. Includes subtle gallop rotation animation
       * 5. Auto cleanup after animation completes
       */
      function initializeBulletEasterEgg() {
        const trigger = document.getElementById('osu-easter-egg-trigger');
        if (!trigger) return;

        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let isAnimating = false;

        trigger.addEventListener('click', function() {
          // Prevent retriggering during animation
          if (isAnimating) return;

          // Respect reduced motion preference
          if (prefersReducedMotion) {
            console.log('Bullet easter egg disabled: user prefers reduced motion');
            return;
          }

          isAnimating = true;

          // 1. Create and show notification
          const notification = document.createElement('div');
          notification.className = 'bullet-notification';
          notification.textContent = 'Here comes Bullet!';
          document.body.appendChild(notification);

          // Trigger fade in
          requestAnimationFrame(() => {
            notification.classList.add('show');
          });

          // Fade out notification after 1.5s
          setTimeout(() => {
            notification.classList.add('fade-out');

            // Remove notification after fade completes
            setTimeout(() => {
              notification.remove();
            }, 500);
          }, 1500);

          // 2. Create and animate Bullet the horse (starts as notification fades)
          setTimeout(() => {
            const bulletContainer = document.createElement('div');
            bulletContainer.className = 'bullet-container';

            const bulletImg = document.createElement('img');
            bulletImg.src = '/Bullet.png';
            bulletImg.alt = 'Bullet the horse';
            bulletImg.className = 'bullet-horse';

            bulletContainer.appendChild(bulletImg);
            document.body.appendChild(bulletContainer);

            // Trigger gallop animation
            requestAnimationFrame(() => {
              bulletContainer.classList.add('galloping');
            });

            // Clean up after animation completes (10 seconds)
            setTimeout(() => {
              bulletContainer.remove();
              isAnimating = false;
            }, 10000);
          }, 1800);
        });
      }

      initializeBulletEasterEgg();
      document.addEventListener('astro:after-swap', initializeBulletEasterEgg);
    </script>

    <script is:inline>
      /**
       * LOCK EASTER EGG - PASSWORD PROTECTED SECRET OVERLAY
       *
       * Correct password: MJL
       *
       * Flow:
       * 1. Click hidden lock icon in top-right
       * 2. Password modal appears
       * 3. Enter correct password "MJL" and press Enter
       * 4. Secret overlay opens (easy to customize - search "EDIT SECRET CONTENT")
       */
      function initializeLockEasterEgg() {
        // Elements
        const lockTrigger = document.getElementById('lock-trigger');
        const passwordModal = document.getElementById('password-modal');
        const passwordInput = document.getElementById('password-input');
        const passwordError = document.getElementById('password-error');
        const passwordClose = document.getElementById('password-close');
        const passwordBackdrop = document.getElementById('password-modal-backdrop');
        const secretOverlay = document.getElementById('secret-overlay');
        const secretClose = document.getElementById('secret-close');
        const secretBackdrop = document.getElementById('secret-overlay-backdrop');

        if (!lockTrigger || !passwordModal || !passwordInput || !secretOverlay) return;

        const CORRECT_PASSWORD = 'MJL';

        // Open password modal
        function openPasswordModal() {
          passwordModal.classList.remove('hidden');
          passwordInput.value = '';
          passwordError.classList.add('hidden');
          // Focus input for accessibility
          setTimeout(() => passwordInput.focus(), 100);
        }

        // Close password modal
        function closePasswordModal() {
          passwordModal.classList.add('hidden');
          passwordInput.value = '';
          passwordError.classList.add('hidden');
        }

        // Open secret overlay
        function openSecretOverlay() {
          secretOverlay.classList.remove('hidden');
        }

        // Close secret overlay
        function closeSecretOverlay() {
          secretOverlay.classList.add('hidden');
        }

        // Show error with shake animation
        function showError() {
          passwordError.classList.remove('hidden');
          passwordInput.classList.add('shake-error');
          setTimeout(() => {
            passwordInput.classList.remove('shake-error');
          }, 500);
        }

        // Check password
        function checkPassword() {
          const entered = passwordInput.value.trim();
          if (entered === CORRECT_PASSWORD) {
            // Correct password
            closePasswordModal();
            openSecretOverlay();
          } else {
            // Incorrect password
            showError();
            passwordInput.value = '';
          }
        }

        // Event Listeners
        lockTrigger.addEventListener('click', openPasswordModal);

        passwordClose.addEventListener('click', closePasswordModal);
        passwordBackdrop.addEventListener('click', closePasswordModal);

        secretClose.addEventListener('click', closeSecretOverlay);
        secretBackdrop.addEventListener('click', closeSecretOverlay);

        // Enter key submits password
        passwordInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            checkPassword();
          }
        });

        // Escape key closes modals
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (!passwordModal.classList.contains('hidden')) {
              closePasswordModal();
            } else if (!secretOverlay.classList.contains('hidden')) {
              closeSecretOverlay();
            }
          }
        });
      }

      initializeLockEasterEgg();
      document.addEventListener('astro:after-swap', initializeLockEasterEgg);
    </script>

    <script is:inline>
      /**
       * HOTDOG CHAMPION EASTER EGG
       * - Hidden hotdog icon in bottom-left corner (only visible on hover)
       * - Click to reveal championship achievement overlay
       * - Shows hotdog.png image and championship description
       */
      function initializeHotdogEasterEgg() {
        const hotdogTrigger = document.getElementById('hotdog-trigger');
        const hotdogOverlay = document.getElementById('hotdog-overlay');
        const hotdogClose = document.getElementById('hotdog-close');
        const hotdogBackdrop = document.getElementById('hotdog-overlay-backdrop');
        const confettiContainer = document.getElementById('confetti-container');

        if (!hotdogTrigger || !hotdogOverlay || !hotdogClose || !hotdogBackdrop || !confettiContainer) return;

        function createConfetti() {
          // Check for reduced motion preference
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (prefersReducedMotion) return;

          const colors = ['#f97316', '#fbbf24', '#ef4444', '#fcd34d', '#fb923c'];
          const confettiCount = 50;

          for (let i = 0; i < confettiCount; i++) {
            const confetti = document.createElement('div');
            confetti.className = 'confetti';

            // Random positioning
            confetti.style.left = Math.random() * 100 + '%';
            confetti.style.top = '-10px';

            // Random color
            confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];

            // Random delay for staggered effect
            confetti.style.animationDelay = Math.random() * 0.5 + 's';

            // Random size variation
            const size = Math.random() * 6 + 6; // 6-12px
            confetti.style.width = size + 'px';
            confetti.style.height = size + 'px';

            confettiContainer.appendChild(confetti);

            // Remove confetti after animation completes
            setTimeout(() => {
              confetti.remove();
            }, 3500);
          }
        }

        function openHotdogOverlay() {
          hotdogOverlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';

          // Trigger confetti
          createConfetti();
        }

        function closeHotdogOverlay() {
          hotdogOverlay.classList.add('hidden');
          document.body.style.overflow = '';

          // Clear any remaining confetti
          confettiContainer.innerHTML = '';
        }

        // Event Listeners
        hotdogTrigger.addEventListener('click', openHotdogOverlay);
        hotdogClose.addEventListener('click', closeHotdogOverlay);
        hotdogBackdrop.addEventListener('click', closeHotdogOverlay);

        // Escape key closes hotdog overlay
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !hotdogOverlay.classList.contains('hidden')) {
            closeHotdogOverlay();
          }
        });
      }

      initializeHotdogEasterEgg();
      document.addEventListener('astro:after-swap', initializeHotdogEasterEgg);
    </script>

