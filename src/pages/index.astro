      /**
       * Bullet horse image
       * - Height sized 2.5x larger than original
       * - Responsive: 70px (mobile min) to 140px (desktop max)
       * - Auto width maintains aspect ratio
       * - Smooth rendering
       */
      .bullet-horse {
        height: clamp(70px, 8.75rem, 140px);
        width: auto;
        display: block;
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
      }

      /**
       * Galloping animation
       * - Horizontal movement: SLOWER - 10s traverse (was 6s)
       * - Rotation: FASTER gallop - alternates every 6.25% (was 12.5%)
       * - More frequent rocking for energetic gallop effect
       */
      @keyframes gallop {
        0% {
          transform: translateX(0) translateY(-50%) rotate(0deg);
        }
        6.25% {
          transform: translateX(calc(-12.5vw)) translateY(-50%) rotate(-4deg);
        }
        12.5% {
          transform: translateX(calc(-25vw)) translateY(-50%) rotate(0deg);
        }
        18.75% {
          transform: translateX(calc(-37.5vw)) translateY(-50%) rotate(4deg);
        }
        25% {
          transform: translateX(calc(-50vw)) translateY(-50%) rotate(0deg);
        }
        31.25% {
          transform: translateX(calc(-62.5vw)) translateY(-50%) rotate(-4deg);
        }
        37.5% {
          transform: translateX(calc(-75vw)) translateY(-50%) rotate(0deg);
        }
        43.75% {
          transform: translateX(calc(-87.5vw)) translateY(-50%) rotate(4deg);
        }
        50% {
          transform: translateX(calc(-100vw)) translateY(-50%) rotate(0deg);
        }
        56.25% {
          transform: translateX(calc(-112.5vw)) translateY(-50%) rotate(-4deg);
        }
        62.5% {
          transform: translateX(calc(-125vw)) translateY(-50%) rotate(0deg);
        }
        68.75% {
          transform: translateX(calc(-137.5vw)) translateY(-50%) rotate(4deg);
        }
        75% {
          transform: translateX(calc(-150vw)) translateY(-50%) rotate(0deg);
        }
        81.25% {
          transform: translateX(calc(-162.5vw)) translateY(-50%) rotate(-4deg);
        }
        87.5% {
          transform: translateX(calc(-175vw)) translateY(-50%) rotate(0deg);
        }
        93.75% {
          transform: translateX(calc(-187.5vw)) translateY(-50%) rotate(4deg);
        }
        100% {
          transform: translateX(calc(-200vw)) translateY(-50%) rotate(0deg);
        }
      }

      .bullet-container.galloping {
        animation: gallop 10s linear forwards;
      }

      /* Respect reduced motion preference */
      @media (prefers-reduced-motion: reduce) {
        .bullet-notification,
        .bullet-container {
          display: none !important;
        }
      }

      /* ===== LOCK EASTER EGG STYLES ===== */

      /**
       * Lock trigger button
       * - Hidden by default (opacity 0)
       * - Appears only on hover
       * - Positioned in top-right corner
       * - Larger hit area than visible icon
       */
      .lock-trigger {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 100;
        padding: 12px;
        background: transparent;
        border: none;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .lock-trigger:hover {
        opacity: 1;
      }

      .lock-icon {
        width: 20px;
        height: 20px;
        stroke: #ff7800;
        stroke-width: 2;
      }

      /**
       * Hotdog trigger button
       * - Hidden by default (opacity 0)
       * - Appears only on hover
       * - Positioned in bottom-left corner (unexpected location)
       * - Larger hit area than visible icon
       */
      .hotdog-trigger {
        position: absolute;
        bottom: 20px;
        left: 20px;
        z-index: 100;
        padding: 12px;
        background: transparent;
        border: none;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .hotdog-trigger:hover {
        opacity: 1;
      }

      .hotdog-icon {
        width: 20px;
        height: 20px;
        color: #ff7800;
      }

      /**
       * Confetti animation for hotdog champion popup
       * - Individual confetti pieces fall from top
       * - Random colors (orange, yellow, red, gold)
       * - Slight rotation during fall
       */
      .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        opacity: 0.9;
        animation: confetti-fall 3s linear forwards;
      }

      @keyframes confetti-fall {
        0% {
          transform: translateY(-10px) rotate(0deg);
          opacity: 1;
        }
        100% {
          transform: translateY(100vh) rotate(360deg);
          opacity: 0;
        }
      }

      /* Disable confetti animation for reduced motion preference */
      @media (prefers-reduced-motion: reduce) {
        .confetti {
          animation: none;
          display: none;
        }
      }

      /**
       * Shake animation for password error
       * - Subtle horizontal shake
       * - Used when incorrect password entered
       */
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-8px); }
        75% { transform: translateX(8px); }
      }

      .shake-error {
        animation: shake 0.3s ease-in-out;
        border-color: #ef4444 !important;
      }

      /* Disable shake animation for reduced motion preference */
      @media (prefers-reduced-motion: reduce) {
        .shake-error {
          animation: none;
          border-color: #ef4444 !important;
        }
      }

      /**
       * Resume Button Bounce Animation
       * - Applied to text during "compiling..." state
       * - Subtle vertical bounce (3px)
       * - Technical, restrained feel
       */
      @keyframes resume-compile-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3px); }
      }

      .resume-compiling {
        animation: resume-compile-bounce 350ms ease-in-out infinite;
      }

      /* Disable bounce animation for reduced motion preference */
      @media (prefers-reduced-motion: reduce) {
        .resume-compiling {
          animation: none;
        }
      }
    </style>

    <script is:inline>
      /**
       * Resume Download with Fake Compile Delay
       * - Intercepts download click
       * - Shows "compiling..." with bounce animation
       * - Delays 800ms before triggering download
       */
      function initializeResumeDownload() {
        const btn = document.getElementById('resume-download-btn');
        const textSpan = document.getElementById('resume-btn-text');

        if (!btn || !textSpan) return;

        btn.addEventListener('click', function(e) {
          // Prevent default download
          e.preventDefault();

          // Store original href
          const resumeUrl = btn.getAttribute('href');

          // Disable button and change text
          btn.style.pointerEvents = 'none';
          btn.classList.add('opacity-75');
          textSpan.textContent = 'compiling...';
          textSpan.classList.add('resume-compiling');

          // After 800ms delay, trigger download and reset
          setTimeout(() => {
            // Trigger actual download
            const link = document.createElement('a');
            link.href = resumeUrl;
            link.download = '';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Reset button state
            textSpan.classList.remove('resume-compiling');
            textSpan.textContent = 'Download Resume';
            btn.classList.remove('opacity-75');
            btn.style.pointerEvents = '';
          }, 800);
        });
      }

      initializeResumeDownload();
      document.addEventListener('astro:after-swap', initializeResumeDownload);
    </script>
  </body>
</html>
