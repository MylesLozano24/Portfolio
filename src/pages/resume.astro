---
import Layout from '../layouts/Layout.astro';
import profileData from '../data/profile.json';
---

<Layout
  title={`Resume - ${profileData.name}`}
  description="Professional experience and qualifications"
>
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="mb-12 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-slide-up">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white">
          Resume
        </h1>
        <a
          href="/resume.pdf"
          download
          class="inline-flex items-center px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-700 dark:hover:bg-gray-200 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download PDF
        </a>
      </div>

      <div class="space-y-12">
        <section class="animate-fade-in" style="animation-delay: 0.1s;">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b-2 border-gray-900 dark:border-white">
            Experience
          </h2>
          <div class="space-y-8">
            <div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                    Senior Full Stack Developer
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    Tech Company Inc.
                  </p>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-500 mt-1 sm:mt-0">
                  2021 - Present
                </p>
              </div>
              <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300">
                <li>Led development of core platform features used by 100K+ users</li>
                <li>Architected and implemented microservices infrastructure</li>
                <li>Mentored junior developers and conducted code reviews</li>
                <li>Improved application performance by 40% through optimization</li>
              </ul>
            </div>

            <div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                    Full Stack Developer
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    StartupXYZ
                  </p>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-500 mt-1 sm:mt-0">
                  2019 - 2021
                </p>
              </div>
              <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300">
                <li>Built responsive web applications using React and Node.js</li>
                <li>Collaborated with designers to implement pixel-perfect UIs</li>
                <li>Integrated third-party APIs and payment systems</li>
                <li>Participated in agile development processes</li>
              </ul>
            </div>
          </div>
        </section>

        <section class="animate-fade-in" style="animation-delay: 0.2s;">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b-2 border-gray-900 dark:border-white">
            Education
          </h2>
          <div class="space-y-6">
            <div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                    Bachelor of Science in Computer Science
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    University Name
                  </p>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-500 mt-1 sm:mt-0">
                  2015 - 2019
                </p>
              </div>
              <p class="text-gray-700 dark:text-gray-300">
                Graduated with honors. Focus on software engineering and web development.
              </p>
            </div>
          </div>
        </section>

        <section class="animate-fade-in" style="animation-delay: 0.3s;">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b-2 border-gray-900 dark:border-white">
            Skills
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                Frontend
              </h3>
              <div class="flex flex-wrap gap-2">
                {['React', 'Vue.js', 'TypeScript', 'Tailwind CSS', 'Next.js', 'Astro'].map((skill) => (
                  <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                Backend
              </h3>
              <div class="flex flex-wrap gap-2">
                {['Node.js', 'Python', 'PostgreSQL', 'MongoDB', 'Redis', 'GraphQL'].map((skill) => (
                  <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                Tools & Platforms
              </h3>
              <div class="flex flex-wrap gap-2">
                {['Git', 'Docker', 'AWS', 'Vercel', 'GitHub Actions', 'Figma'].map((skill) => (
                  <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                Other
              </h3>
              <div class="flex flex-wrap gap-2">
                {['Responsive Design', 'REST APIs', 'Testing', 'CI/CD', 'Agile', 'Accessibility'].map((skill) => (
                  <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg text-sm">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="animate-fade-in" style="animation-delay: 0.4s;">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 pb-2 border-b-2 border-gray-900 dark:border-white">
            Awards & Recognition
          </h2>
          <div class="space-y-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                Outstanding Developer Award
              </h3>
              <p class="text-gray-600 dark:text-gray-400">
                Tech Company Inc., 2023
              </p>
              <p class="text-gray-700 dark:text-gray-300 mt-1">
                Recognized for exceptional contributions to product development and team leadership.
              </p>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                Hackathon Winner
              </h3>
              <p class="text-gray-600 dark:text-gray-400">
                City Tech Hackathon, 2020
              </p>
              <p class="text-gray-700 dark:text-gray-300 mt-1">
                First place for building an innovative solution to improve urban mobility.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>
